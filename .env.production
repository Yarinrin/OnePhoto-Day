# Production build values.
#
# Both of these are meant to be public. Supabase's publishable key is designed
# to ship inside client-side JavaScript — it identifies the project, it does not
# grant access. Every table it can reach is guarded by row-level security, so
# what this key can actually see depends entirely on who is signed in.
#
# Committing them means any host builds correctly with no configuration at all.
# The key that must never appear here is the service_role key, which bypasses
# row-level security. It is not used anywhere in this app.

VITE_SUPABASE_URL=https://fyypspxdfafybldcsrdq.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_QVhhThV_5AL9Ha9pad0RMA_aayqjr92
